    "experiment:handoff": "bun experiments/automatic-handoff/run.ts",
    "experiment:construction": "bun experiments/construction/run.ts",
    "experiment:cg": "bun scripts/test-runtime.ts && bun experiments/code-generation/run.ts",
    "experiment:codex-host": "bun scripts/test-runtime.ts && bun experiments/codex-host/run.ts",
    "experiment:construction-phase": "bun scripts/test-runtime.ts && bun experiments/construction-phase/run.ts"
  },
  "devDependencies": {
    "bun-types": "1.3.13",
    "typescript": "6.0.3"
