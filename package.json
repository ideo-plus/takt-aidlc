{
  "name": "takt-aidlc",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun scripts/test-runtime.ts && bun test tests/handoff.test.ts tests/plugin.test.ts tests/environment.test.ts tests/construction.test.ts tests/code-generation.test.ts tests/codex-plugin.test.ts tests/construction-phase.test.ts",
    "prepare:test-runtime": "bun scripts/test-runtime.ts",
    "build:plugin": "bun scripts/build-plugin.ts",
